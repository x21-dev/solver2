{
    "name": "solver2-spike",
    "description": "The spike that came before the C interface: Python calls D. Throwaway.",
    "dependencies": {
        "solver2": {
            "path": ".."
        }
    },
    "configurations": [
        {
            "name": "library",
            "targetType": "dynamicLibrary",
            "targetName": "spike",
            "excludedSourceFiles": [
                "source/native.d"
            ],
            "dflags": [
                "-fvisibility=hidden",
                "-dllimport=none",
                "-link-defaultlib-shared=false",
                "-boundscheck=on"
            ]
        },
        {
            "name": "native",
            "targetType": "executable",
            "targetName": "spike-native",
            "mainSourceFile": "source/native.d"
        }
    ]
}
